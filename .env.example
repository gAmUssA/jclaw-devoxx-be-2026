# Jev handles intent/event decisions. Gemini handles chat, draft/refine and Judge.
# Get your Jev key from TypeSafe: https://docs.typesafe.ai/api
TYPESAFE_API_KEY=''
# Select the decision transport explicitly; Gemini is comparison-only.
JCLAW_DECIDER=jev
# Get your Gemini key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=''
# Provisional Gemini generation roles. Final draft/Judge transports remain deferred.
# Agree the final model/transport lineup before rehearsal and comparison.
JCLAW_GEMINI_MODEL=gemini-3.7-flash
# Optional per-role Gemini API model overrides; empty means JCLAW_GEMINI_MODEL.
# Chat and runtime skills.
JCLAW_CHAT_MODEL=
# Only used with explicit JCLAW_DECIDER=gemini comparison mode; never a fallback.
JCLAW_IDENTIFY_MODEL=
# Draft/refine the typed plan; both critics share six refinements per request.
JCLAW_DRAFT_MODEL=
# Independently review the exact typed request and plan.
JCLAW_REVIEW_MODEL=
# success, refused, wrong-call, wrong-candidate, wrong-event, malformed, error
JCLAW_MOCK_DELIVERY=success
