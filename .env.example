# Jev decides; Gemini chats; Claude drafts/refines; OpenAI judges.
# Get your Jev key from TypeSafe: https://docs.typesafe.ai/api
TYPESAFE_API_KEY=''
# Select the decision transport explicitly; Gemini is comparison-only.
JCLAW_DECIDER=jev
# Get your Gemini key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=''
# Chat and skills use Gemini. Rounds 1–4 need only the Google credential.
JCLAW_GEMINI_MODEL=gemini-3.7-flash
# Optional Gemini overrides; empty means JCLAW_GEMINI_MODEL.
JCLAW_CHAT_MODEL=
# Only used with explicit JCLAW_DECIDER=gemini comparison mode; never a fallback.
JCLAW_IDENTIFY_MODEL=
# Rounds 5–7 also require Anthropic and OpenAI API credentials (paid API usage).
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=''
# Claude Draft/Refine; both critics share six refinements per request.
JCLAW_DRAFT_MODEL=claude-opus-5-5
# https://platform.openai.com/api-keys
OPENAI_API_KEY=''
# GPT-6 Astra Judge reviews the exact typed request and plan.
JCLAW_REVIEW_MODEL=gpt-6-astra
# success, refused, wrong-call, wrong-candidate, wrong-event, malformed, error
JCLAW_MOCK_DELIVERY=success
